{
  "routes": [
    {
      "prefix": "/api/auth/login",
      "service": "auth-service",
      "rules": [
        {
          "methods": [
            "POST"
          ],
          "auth": false,
          "rateLimit": {
            "windowMs": 60000,
            "max": 10
          }
        }
      ]
    },
    {
      "prefix": "/api/auth/register",
      "service": "auth-service",
      "rules": [
        {
          "methods": [
            "POST"
          ],
          "auth": false,
          "rateLimit": {
            "windowMs": 60000,
            "max": 10
          }
        }
      ]
    },
    {
      "prefix": "/api/auth/users",
      "service": "auth-service",
      "rules": [
        {
          "methods": [
            "*"
          ],
          "roles": [
            "admin",
            "giangvien"
          ]
        }
      ]
    },
    {
      "prefix": "/api/auth",
      "service": "auth-service",
      "rules": [
        {
          "methods": [
            "GET",
            "POST"
          ],
          "roles": [
            "*"
          ]
        }
      ]
    },
    {
      "prefix": "/api/students",
      "service": "student-service",
      "rules": [
        {
          "methods": [
            "GET"
          ],
          "roles": [
            "admin",
            "giangvien"
          ]
        },
        {
          "methods": [
            "POST",
            "PUT",
            "DELETE"
          ],
          "roles": [
            "admin"
          ]
        }
      ]
    },
    {
      "prefix": "/api/topics",
      "service": "topic-service",
      "rules": [
        {
          "methods": [
            "GET"
          ],
          "roles": [
            "admin",
            "giangvien",
            "sinhvien"
          ]
        },
        {
          "methods": [
            "POST",
            "PUT",
            "DELETE"
          ],
          "roles": [
            "admin",
            "giangvien"
          ]
        }
      ]
    },
    {
      "prefix": "/api/registrations",
      "service": "registration-service",
      "rules": [
        {
          "methods": [
            "GET",
            "POST",
            "DELETE"
          ],
          "roles": [
            "admin",
            "giangvien",
            "sinhvien"
          ]
        },
        {
          "methods": [
            "PUT"
          ],
          "roles": [
            "admin",
            "giangvien"
          ]
        }
      ]
    },
    {
      "prefix": "/api/notifications",
      "service": "notification-service",
      "rules": [
        {
          "methods": [
            "GET",
            "PUT"
          ],
          "roles": [
            "admin",
            "giangvien",
            "sinhvien"
          ]
        }
      ]
    }
  ],
  "limits": {
    "bodyBytes": 1048576,
    "global": {
      "windowMs": 60000,
      "max": 600
    }
  },
  "cors": {
    "origins": [
      "*"
    ]
  },
  "version": 3
}